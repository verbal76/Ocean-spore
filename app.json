      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0cc1bf9c-b6c8-4ec7-bf71-4f7d6bb5b5d3"
      }
    }
