{
  "expo": {
    "name": "Ocean Spore",
    "slug": "ocean-spore",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "oceanspore",
    "newArchEnabled": false,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#03101c"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.verbal76.oceanspore"
    },
    "android": {
      "package": "com.verbal76.oceanspore",
      "adaptiveIcon": {
        "backgroundColor": "#03101c"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ]
  }
}
