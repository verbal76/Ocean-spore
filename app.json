{
  "expo": {
    "name": "Ocean Spore",
    "slug": "ocean-spore",
    "owner": "hot-attic-games",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "oceanspore",
    "newArchEnabled": false,
    "runtimeVersion": "2.0.0",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#03101c"
    },
    "updates": {
      "url": "https://u.expo.dev/0cc1bf9c-b6c8-4ec7-bf71-4f7d6bb5b5d3",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.verbal76.oceanspore"
    },
    "android": {
      "package": "com.verbal76.oceanspore",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-foreground.png",
        "backgroundImage": "./assets/icons/adaptive-background.png",
        "monochromeImage": "./assets/icons/adaptive-monochrome.png",
        "backgroundColor": "#03101c"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-updates",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      "./plugins/with-no-compress-glb"
    ],
    "extra": {
      "eas": {
        "projectId": "0cc1bf9c-b6c8-4ec7-bf71-4f7d6bb5b5d3"
      }
    },
    "icon": "./assets/icons/icon.png"
  }
}
