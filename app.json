{
  "expo": {
    "name": "Ocean Spore",
    "slug": "ocean-spore",
    "owner": "hot-attic-games",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "oceanspore",
    "newArchEnabled": false,
    "runtimeVersion": "2.1.0",
    "updates": {
      "url": "https://u.expo.dev/0cc1bf9c-b6c8-4ec7-bf71-4f7d6bb5b5d3",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.verbal76.oceanspore"
    },
    "android": {
      "package": "com.verbal76.oceanspore",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-foreground.png",
        "backgroundImage": "./assets/icons/adaptive-background.png",
        "monochromeImage": "./assets/icons/adaptive-monochrome.png",
        "backgroundColor": "#03101c"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#03101c",
          "image": "./assets/branding/splash-blank.png",
          "imageWidth": 200
        }
      ],
      "expo-updates",
      "./plugins/with-no-compress-glb",
      "./plugins/with-trim-audio-manifest"
    ],
    "extra": {
      "eas": {
        "projectId": "0cc1bf9c-b6c8-4ec7-bf71-4f7d6bb5b5d3"
      }
    },
    "icon": "./assets/icons/icon.png",
    "backgroundColor": "#03101c",
    "androidStatusBar": {
      "backgroundColor": "#03101c",
      "barStyle": "light-content"
    }
  }
}
