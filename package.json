{
  "name": "ocean-spore",
  "version": "1.1.0",
  "main": "expo/AppEntry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "build-info": "node scripts/write-build-info.mjs",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "version-info": "node scripts/version.js apk-name"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-asset": "~11.0.0",
    "expo-build-properties": "~0.13.0",
    "expo-clipboard": "~7.0.0",
    "expo-file-system": "~18.0.0",
    "expo-gl": "~15.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-updates": "~0.26.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-svg": "15.8.0",
    "three": "0.169.0",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "@types/three": "^0.169.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.(t|j)sx?$": "babel-jest"
    }
  }
}
