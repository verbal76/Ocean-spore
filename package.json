{
  "name": "ocean-spore",
  "version": "1.1.0",
  "main": "expo/AppEntry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "build-info": "node scripts/write-build-info.mjs",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "version-info": "node scripts/version.js apk-name",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-clipboard": "~8.0.8",
    "expo-file-system": "~19.0.24",
    "expo-gl": "~16.0.10",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "three": "0.169.0",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@types/three": "^0.169.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.(t|j)sx?$": "babel-jest"
    }
  },
  "oceanSpore": {
    "build": 40
  }
}
